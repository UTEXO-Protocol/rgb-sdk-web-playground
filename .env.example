# Regtest infrastructure URLs
# Copy this file to .env and adjust values for your local setup

VITE_REGTEST_INDEXER_URL=http://localhost:8094/regtest/api
VITE_REGTEST_PROXY_HTTP_URL=http://localhost:3000/json-rpc
VITE_REGTEST_PROXY_RPC_URL=rpc://localhost:3000/json-rpc
VITE_REGTEST_BITCOIND_URL=/bitcoind/wallet/miner
VITE_REGTEST_BITCOIND_USER=user
VITE_REGTEST_BITCOIND_PASS=password

# APay UTEXO (signet) flow — LSP & APay page
# Faucet RLN-node REST that funds BTC + sends the RGB top-up (required).
# The browser reaches it through the Vite /faucet-signet proxy.
VITE_SIGNET_FAUCET_URL=
# Bearer token for the signet LSP APay routes (enableLightningAddress).
VITE_SIGNET_LSP_BEARER=
# Optional overrides (defaults: RN-demo asset id, /lsp-signet proxy →
# https://lsp-signet.utexo.com).
# VITE_SIGNET_ASSET_ID=rgb:...
# VITE_SIGNET_LSP_URL=/lsp-signet
# VITE_SIGNET_LSP_TARGET=https://lsp-signet.utexo.com
# VITE_SIGNET_PROXY_WS=wss://...        # WS gateway for the wasm node's LDK P2P
# VITE_SIGNET_INDEXER_URL=https://esplora-api.utexo.com
# VITE_SIGNET_TRANSPORT=rpcs://rgb-proxy.utexo.com/json-rpc
